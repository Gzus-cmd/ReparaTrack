---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import Callout from "../components/Callout.astro";
import Icon from "../components/Icon.astro";
import { serverFetch } from "../lib/server.js";
import { CATALOGS } from "../lib/api.js";

const results = await Promise.all(CATALOGS.map((catalog) => serverFetch(`/catalogs/${catalog.slug}`)));
const catalogs = CATALOGS.map((catalog, index) => ({
  ...catalog,
  ok: results[index].ok,
  error: results[index].error,
  values: results[index].ok ? results[index].data : [],
}));
const apiDown = catalogs.every((catalog) => !catalog.ok);
---

<Layout title="Maestros" description="Administrar catálogos del taller." active="catalogs">
  <PageHeader
    eyebrow="Configuración"
    title="Maestros"
    description="Tipos de dispositivo, marcas, componentes y operaciones. Los valores en uso no se borran: se desactivan."
  />

  {
    apiDown ? (
      <Callout tone="danger" title="No se pudo cargar los maestros">{catalogs.find((c) => !c.ok)?.error}</Callout>
    ) : (
      <div class="stack stack--lg">
        {catalogs.map((catalog) => (
          <section class="card" data-catalog={catalog.slug}>
            <div class="card__header">
              <h2 class="card__title">
                <Icon name="settings" size={18} />
                {catalog.label}
              </h2>
              <form class="row" data-add-form style="gap: 8px;">
                <input class="input input--sm" name="name" placeholder={`Nuevo ${catalog.singular}`} required />
                <button class="btn btn--primary btn--sm" type="submit">Agregar</button>
              </form>
            </div>
            <div class="card__body">
              {catalog.values.length === 0 ? (
                <p class="muted" style="margin: 0;">Sin valores todavía.</p>
              ) : (
                <ul class="plain-list">
                  {catalog.values.map((value) => (
                    <li class="catalog-row" data-id={value.id} data-name={value.name}>
                      <span class:list={[!value.is_active && "muted"]}>
                        {value.name}
                        {!value.is_active && <span class="muted"> (inactivo)</span>}
                      </span>
                      {value.in_use && <span class="badge badge--neutral">en uso</span>}
                      <span class="row" style="gap: 6px; margin-left: auto;">
                        <button
                          class="btn btn--ghost btn--sm"
                          data-action={value.is_active ? "deactivate" : "activate"}
                        >
                          {value.is_active ? "Desactivar" : "Activar"}
                        </button>
                        {!value.in_use && (
                          <button class="btn btn--ghost btn--sm" data-action="delete">Borrar</button>
                        )}
                      </span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </section>
        ))}
      </div>
    )
  }
</Layout>

<script>
  import { apiFetch, postJson } from "../lib/api.js";
  import { toast, confirmAction, setBusy } from "../lib/ui.js";

  document.querySelectorAll("[data-add-form]").forEach((form) => {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const section = form.closest("[data-catalog]");
      const slug = section?.dataset.catalog;
      const input = form.querySelector('input[name="name"]');
      const name = input.value.trim();
      const button = form.querySelector('button[type="submit"]');
      if (!slug || !name) return;
      setBusy(button, true, "Guardando…");
      try {
        await postJson(`/catalogs/${slug}`, { name });
        toast("Valor agregado.", { tone: "success" });
        window.location.reload();
      } catch (error) {
        toast(error.message, { tone: "error" });
        setBusy(button, false);
      }
    });
  });

  document.querySelectorAll("[data-action]").forEach((button) => {
    button.addEventListener("click", async () => {
      const row = button.closest("[data-id]");
      const section = button.closest("[data-catalog]");
      const slug = section?.dataset.catalog;
      const id = row?.dataset.id;
      const name = row?.dataset.name;
      const action = button.dataset.action;
      if (!slug || !id) return;
      try {
        if (action === "delete") {
          const ok = await confirmAction({
            title: `Borrar «${name}»`,
            body: "Esta acción no se puede deshacer.",
            danger: true,
            confirmLabel: "Borrar",
          });
          if (!ok) return;
          await apiFetch(`/catalogs/${slug}/${id}`, { method: "DELETE" });
        } else {
          await apiFetch(`/catalogs/${slug}/${id}/${action}`, { method: "POST" });
        }
        toast("Cambios guardados.", { tone: "success" });
        window.location.reload();
      } catch (error) {
        toast(error.message, { tone: "error" });
      }
    });
  });
</script>
