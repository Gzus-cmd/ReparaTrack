---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import ServiceList from "../components/ServiceList.astro";
import Callout from "../components/Callout.astro";
import Icon from "../components/Icon.astro";
import { serverFetch } from "../lib/server.js";
import { STATUSES, statusLabel } from "../lib/api.js";

const url = Astro.url;
const status = url.searchParams.get("status");
const result = await serverFetch(`/service-orders${status ? `?status=${status}` : ""}`);

const items = result.ok ? (Array.isArray(result.data) ? result.data : result.data.items ?? []) : [];
const total = result.ok ? (Array.isArray(result.data) ? result.data.length : result.data.total ?? items.length) : 0;

const services = items.map((s) => ({
  id: s.id,
  code: s.equipment?.internal_code ?? `#${s.id}`,
  customer: s.customer?.name ?? "—",
  deviceType: s.equipment?.model ?? "",
  status: s.status,
  statusLabel: s.status_label,
  receivedAt: s.received_at,
  daysInStatus: s.days_in_status,
  detailsCount: s.details_count,
  alertRule: null,
}));

const chips = [{ key: null, label: "Todos", count: total }].concat(
  STATUSES.map((st) => ({ key: st.key, label: st.label, count: null })),
);

const PAGE_SIZE = 8;
const totalPages = Math.max(1, Math.ceil(services.length / PAGE_SIZE));
const requestedPage = Number(url.searchParams.get("page") ?? "1");
const page = Math.min(Math.max(1, Number.isFinite(requestedPage) ? requestedPage : 1), totalPages);
const paged = services.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);
const pageUrl = (targetPage) => {
  const params = new URLSearchParams();
  if (status) params.set("status", status);
  if (targetPage > 1) params.set("page", String(targetPage));
  const qs = params.toString();
  return `/services${qs ? `?${qs}` : ""}`;
};
---

<Layout title="Servicios" description="Bandeja completa de servicios del taller." active="services">
  <PageHeader
    eyebrow="Servicios"
    title="Bandeja de servicios"
    description="Todos los servicios, incluidos los entregados y abandonados. Tocá uno para ver su ficha."
  >
    <a slot="actions" class="btn btn--primary" href="/reception">
      <Icon name="plus" size={17} />
      Nueva recepción
    </a>
  </PageHeader>

  {
    !result.ok ? (
      <Callout tone="danger" title="No se pudo cargar la bandeja">{result.error}</Callout>
    ) : (
      <section class="card">
        <div class="card__header">
          <h2 class="card__title">
            <Icon name="list" size={18} />
            {total} {total === 1 ? "servicio" : "servicios"}
          </h2>
          {status && (
            <span class="muted" style="font-size: var(--text-xs);">
              Filtro: {statusLabel(status)}
            </span>
          )}
        </div>
        <div style="padding: 12px 20px; border-bottom: 1px solid var(--border);">
          <div class="chips" aria-label="Filtrar por estado">
            {chips.map((chip) => (
              <a
                class="chip"
                href={chip.key ? `/services?status=${chip.key}` : "/services"}
                aria-current={status === chip.key ? "page" : undefined}
              >
                {chip.key && <span class="status-dot" data-status={chip.key} />}
                {chip.label}
                {chip.count !== null && <span class="tab__count">{chip.count}</span>}
              </a>
            ))}
          </div>
        </div>
        <ServiceList services={paged} emptyTitle="No hay servicios" emptyText="Recepcioná un equipo para empezar." />

        {totalPages > 1 && (
          <nav class="pagination" aria-label="Paginación de servicios">
            {page > 1 ? (
              <a class="btn btn--ghost btn--sm" href={pageUrl(page - 1)}>← Anterior</a>
            ) : (
              <span />
            )}
            <span class="pagination__info">Página {page} de {totalPages}</span>
            {page < totalPages ? (
              <a class="btn btn--ghost btn--sm" href={pageUrl(page + 1)}>Siguiente →</a>
            ) : (
              <span />
            )}
          </nav>
        )}
      </section>
    )
  }
</Layout>
