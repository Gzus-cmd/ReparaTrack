---
import Sidebar from "../components/Sidebar.astro";
import "../styles/global.css";

/**
 * Shell de la aplicación: metadatos, navegación, contenido y contenedores
 * globales de notificaciones.
 */
const {
  title = "ReparaTrack",
  description = "Trazabilidad de equipos en taller para TerabyteRS.",
  active = "dashboard",
} = Astro.props;

const pageTitle = title === "ReparaTrack" ? "ReparaTrack · Taller TerabyteRS" : `${title} · ReparaTrack`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d1738" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@600;700&family=JetBrains+Mono:wght@400;600&display=swap"
    />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <Sidebar active={active} />

    <div class="app-page">
      <main id="contenido" class="page-inner">
        <slot />
      </main>

      <footer class="page-footer">
        <span>ReparaTrack · Trazabilidad de taller · TerabyteRS</span>
        <span>API <code class="mono">/api/v1</code> · interfaz Astro</span>
      </footer>
    </div>

    <div id="confirm-root"></div>
    <div id="toast-root" class="toast-root" aria-live="polite" aria-atomic="true"></div>
  </body>
</html>
