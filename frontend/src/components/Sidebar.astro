---
import Icon from "./Icon.astro";

/**
 * Navegación lateral fija en escritorio y cajón deslizante en móvil.
 * `active` marca la sección actual para `aria-current="page"`.
 */
const { active = "dashboard" } = Astro.props;

const groups = [
  {
    label: "Operación",
    items: [
      { key: "dashboard", href: "/", label: "Tablero", icon: "dashboard" },
      { key: "reception", href: "/reception", label: "Recepción", icon: "plusSquare" },
      { key: "services", href: "/services", label: "Servicios", icon: "list" },
    ],
  },
  {
    label: "Consultas",
    items: [
      { key: "equipments", href: "/equipments", label: "Equipos", icon: "monitor" },
      { key: "customers", href: "/customers", label: "Clientes", icon: "users" },
    ],
  },
  {
    label: "Configuración",
    items: [{ key: "catalogs", href: "/catalogs", label: "Maestros", icon: "settings" }],
  },
];
---

<header class="mobile-bar">
  <button
    type="button"
    class="icon-button"
    id="sidebar-toggle"
    aria-controls="app-sidebar"
    aria-expanded="false"
    aria-label="Abrir menú de navegación"
  >
    <Icon name="menu" size={20} />
  </button>
  <a class="mobile-bar__brand" href="/">
    <span class="brand-mark"><Icon name="wrench" size={18} /></span>
    <span>ReparaTrack</span>
  </a>
</header>

<aside class="sidebar" id="app-sidebar" data-open="false" aria-label="Navegación principal">
  <a class="sidebar__brand" href="/">
    <span class="brand-mark"><Icon name="wrench" size={22} /></span>
    <span class="brand-text">
      <strong>ReparaTrack</strong>
      <span>TerabyteRS</span>
    </span>
  </a>

  <nav class="stack stack--lg" aria-label="Secciones">
    {
      groups.map((group) => (
        <div class="sidebar__group">
          <p class="sidebar__label">{group.label}</p>
          {group.items.map((item) => (
            <a
              class="nav-link"
              href={item.href}
              aria-current={active === item.key ? "page" : undefined}
            >
              <Icon name={item.icon} size={19} />
              <span>{item.label}</span>
            </a>
          ))}
        </div>
      ))
    }
  </nav>

  <div class="sidebar__footer">
    <a class="health-pill" id="api-health" href="/" data-state="checking">
      <span class="health-pill__dot" aria-hidden="true"></span>
      <span id="api-health-text">Comprobando API…</span>
    </a>
    <p>ReparaTrack · v0.1</p>
  </div>
</aside>

<button
  type="button"
  class="sidebar-overlay"
  id="sidebar-overlay"
  aria-label="Cerrar menú de navegación"
  hidden
></button>

<script>
  const sidebar = document.getElementById("app-sidebar");
  const toggle = document.getElementById("sidebar-toggle");
  const overlay = document.getElementById("sidebar-overlay");

  function setOpen(open) {
    if (!sidebar || !toggle || !overlay) return;
    sidebar.dataset.open = String(open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Cerrar menú de navegación" : "Abrir menú de navegación");
    overlay.hidden = !open;
    document.body.style.overflow = open ? "hidden" : "";
    if (open) {
      sidebar.querySelector("a")?.focus({ preventScroll: true });
    }
  }

  toggle?.addEventListener("click", () => setOpen(sidebar?.dataset.open !== "true"));
  overlay?.addEventListener("click", () => setOpen(false));
  sidebar?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setOpen(false));
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && sidebar?.dataset.open === "true") {
      setOpen(false);
      toggle?.focus();
    }
  });

  window.matchMedia("(min-width: 1024px)").addEventListener("change", (event) => {
    if (event.matches) setOpen(false);
  });

  // Indicador de salud de la API: no bloquea el render de la página.
  const health = document.getElementById("api-health");
  const healthText = document.getElementById("api-health-text");

  fetch("/api/v1/health", { headers: { accept: "application/json" } })
    .then((response) => {
      if (!response.ok) throw new Error(String(response.status));
      return response.json();
    })
    .then((data) => {
      if (!health || !healthText) return;
      health.dataset.state = data?.status === "ok" ? "ok" : "error";
      healthText.textContent = data?.status === "ok" ? "API conectada" : "API sin conexión";
    })
    .catch(() => {
      if (!health || !healthText) return;
      health.dataset.state = "error";
      healthText.textContent = "API sin conexión";
    });
</script>
