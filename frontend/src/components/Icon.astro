  plus: '<path d="M12 5v14M5 12h14"/>',
  plusSquare: '<rect x="3.5" y="3.5" width="17" height="17" rx="4"/><path d="M12 8.5v7M8.5 12h7"/>',
  list: '<path d="M8 6h13M8 12h13M8 18h13"/><path d="M3.5 6h.01M3.5 12h.01M3.5 18h.01"/>',
  monitor:
    '<rect x="2.5" y="4" width="19" height="12.5" rx="2.5"/><path d="M8.5 20.5h7M12 16.5v4"/>',
  users:
    '<path d="M16 20v-1.5a4 4 0 0 0-4-4H6.5a4 4 0 0 0-4 4V20"/><circle cx="9.25" cy="7.5" r="3.5"/><path d="M17 4.2a3.5 3.5 0 0 1 0 6.6M21.5 20v-1.5a4 4 0 0 0-3-3.85"/>',
  settings:
    '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.87l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.7 1.7 0 0 0-1.87-.34 1.7 1.7 0 0 0-1.03 1.56V21a2 2 0 1 1-4 0v-.1A1.7 1.7 0 0 0 8.9 19.3a1.7 1.7 0 0 0-1.87.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-1.56-1.03H3a2 2 0 1 1 0-4h.1A1.7 1.7 0 0 0 4.7 8.9a1.7 1.7 0 0 0-.34-1.87l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1.03-1.56V3a2 2 0 1 1 4 0v.1A1.7 1.7 0 0 0 15.1 4.7a1.7 1.7 0 0 0 1.87-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.7 1.7 0 0 0 19.4 9v.1a1.7 1.7 0 0 0 1.56 1.03H21a2 2 0 1 1 0 4h-.1A1.7 1.7 0 0 0 19.4 15Z"/>',
  wrench:
    '<path d="M14.7 6.3a4.5 4.5 0 0 0 5.6 5.9L21 12l-9 9a2.8 2.8 0 0 1-4-4l9-9-0.1 0.7Z"/><path d="M6.5 3.5 4 6l3.5 3.5L10 7 6.5 3.5Z"/>',
  alert:
    '<path d="M12 8.5v4.5M12 16.5v.5"/><path d="M10.3 4.3 2.6 17.6a2 2 0 0 0 1.7 3h15.4a2 2 0 0 0 1.7-3L13.7 4.3a2 2 0 0 0-3.4 0Z"/>',
  alertCircle:
    '<circle cx="12" cy="12" r="9"/><path d="M12 8v.5M12 11.5V16"/>',
  check: '<path d="m5 13 4.2 4.2L19 6.5"/>',
  checkCircle: '<circle cx="12" cy="12" r="9"/><path d="m8 12.2 2.6 2.6L16 9.5"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7.5V12l3 1.8"/>',
  arrowRight: '<path d="M5 12h13M13 6.5l5.5 5.5L13 17.5"/>',
  arrowLeft: '<path d="M19 12H6M11 6.5 5.5 12 11 17.5"/>',
  arrowUpRight: '<path d="M7 17 17 7M8.5 7H17v8.5"/>',
  search: '<circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/>',
  x: '<path d="m6 6 12 12M18 6 6 18"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  phone:
    '<path d="M21 16.9v2.4a2 2 0 0 1-2.2 2 19.6 19.6 0 0 1-8.5-3 19.3 19.3 0 0 1-6-6A19.6 19.6 0 0 1 1.3 3.7 2 2 0 0 1 3.3 1.5h2.4a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L6.9 9.2a15.7 15.7 0 0 0 6 6l1.1-1.1a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"/>',
  box:
    '<path d="m12 2.8 8.5 4.6v9.2L12 21.2 3.5 16.6V7.4L12 2.8Z"/><path d="M3.8 7.5 12 12l8.2-4.5M12 12v9.2"/>',
  history:
    '<path d="M3.5 12a8.5 8.5 0 1 0 2.6-6.1L3.5 8.4"/><path d="M3.5 3.8v4.6h4.6M12 8v4.4l3 1.8"/>',
  trash:
    '<path d="M4 7h16M9.5 7V4.8A1.3 1.3 0 0 1 10.8 3.5h2.4a1.3 1.3 0 0 1 1.3 1.3V7"/><path d="M6.5 7l.9 12.2a1.8 1.8 0 0 0 1.8 1.6h5.6a1.8 1.8 0 0 0 1.8-1.6L17.5 7"/><path d="M10.5 11v6M13.5 11v6"/>',
  edit: '<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/>',
  power: '<path d="M12 3v9"/><path d="M7.5 5.8a8 8 0 1 0 9 0"/>',
  chevronRight: '<path d="m9.5 6 6 6-6 6"/>',
  chevronDown: '<path d="m6 9.5 6 6 6-6"/>',
  refresh:
    '<path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 4.5V10h-5.5"/>',
  tag: '<path d="M20.6 13.4 12 22a2 2 0 0 1-2.8 0L2 14.8V3.5h11.3l7.3 7.1a2 2 0 0 1 0 2.8Z"/><circle cx="7.3" cy="8.3" r="1.4"/>',
  calendar:
    '<rect x="3.5" y="5" width="17" height="16" rx="3"/><path d="M8 3v4M16 3v4M3.5 10.5h17"/>',
  shield:
    '<path d="M12 3 5 6v5.5c0 4.4 3 7.6 7 9.5 4-1.9 7-5.1 7-9.5V6l-7-3Z"/><path d="m9 12 2.2 2.2L15.5 10"/>',
  dot: '<circle cx="12" cy="12" r="4"/>',
  filter: '<path d="M4 6h16M7 12h10M10 18h4"/>',
  external: '<path d="M14 4h6v6M20 4 11 13"/><path d="M19 14.5V18a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h3.5"/>',
  person:
    '<circle cx="12" cy="8" r="3.6"/><path d="M4.5 20.5v-1a5 5 0 0 1 5-5h5a5 5 0 0 1 5 5v1"/>',
};

const path = ICONS[name] || ICONS.dot;
const dimension = typeof size === "number" ? `${size}` : size;
---

<svg
  class={className}
  width={dimension}
  height={dimension}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? "img" : undefined}
  aria-hidden={label ? undefined : "true"}
  aria-label={label}
  set:html={path}
/>
