---
/**
 * Set de iconos SVG inline (trazo de 1.7px, 24x24, sin dependencias).
 * `name` decide el dibujo; el tamaño lo controla el contexto con CSS.
 */
const { name = "dot", size = 20, label = undefined, class: className = "" } = Astro.props;

const ICONS = {
